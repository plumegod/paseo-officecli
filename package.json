{
  "name": "paseo-officecli",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Use the complete official OfficeCLI command line and Office file previews inside Paseo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/plumegod/paseo-officecli.git"
  },
  "files": [
    "paseo-plugin.json",
    "AGENTS.md",
    "docs/",
    "README.*.md",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:regression": "node --test tests/integration.mjs tests/commands.integration.mjs",
    "test:integration": "node --test tests/integration.mjs tests/commands.integration.mjs tests/watch.integration.mjs"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.16.0-beta.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.19.2",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
